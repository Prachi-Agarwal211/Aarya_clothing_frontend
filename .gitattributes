# Standardize line endings to LF for all text files
# This prevents Windows CRLF vs Linux/WSL LF pollution from AI tools.

* text=auto eol=lf

# Force LF for all source and configuration files
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.env* text eol=lf
.gitignore text eol=lf
.dockerignore text eol=lf
Dockerfile* text eol=lf

# Treat images, fonts and other media as binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary
